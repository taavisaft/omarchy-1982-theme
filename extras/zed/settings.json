// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "theme_overrides": {
    "One Dark": {
      "background": "#000000",
      "surface.background": "#000000",
      "elevated_surface.background": "#000000",
      "editor.background": "#000000",
      "editor.gutter.background": "#000000",
      "editor.subheader.background": "#0A0A0A",
      "editor.active_line.background": "#0A0A0A",
      "editor.highlighted_line.background": "#141414",
      "editor.foreground": "#8FE88F",
      "editor.line_number": "#555555",
      "editor.active_line_number": "#FFFF55",
      "panel.background": "#000000",
      "panel.indent_guide": "#0D3B0D",
      "panel.indent_guide_hover": "#33FF33",
      "panel.indent_guide_active": "#33FF33",
      "panel.overlay_background": "#0A1A0A",
      "panel.overlay_hover": "#145014",
      "tab_bar.background": "#000000",
      "tab.inactive_background": "#0D2A0D",
      "tab.active_background": "#164016",
      "title_bar.background": "#000000",
      "title_bar.inactive_background": "#000000",
      "toolbar.background": "#000000",
      "status_bar.background": "#000000",
      "element.background": "#0A1A0A",
      "element.hover": "#145014",
      "element.active": "#145014",
      "element.selected": "#0D3B0D",
      "element.selection_background": "#0D3B0D",
      "element.disabled": "#0A1A0A",
      "ghost_element.hover": "#145014",
      "ghost_element.active": "#1B871B",
      "ghost_element.selected": "#1A8F1A",
      "ghost_element.disabled": "#0A1A0A",
      "drop_target.background": "#33FF3366",
      "drop_target.border": "#33FF33",
      "scrollbar.thumb.background": "#0D3B0D80",
      "scrollbar.thumb.hover_background": "#33FF3380",
      "scrollbar.thumb.active_background": "#33FF33AA",
      "scrollbar.thumb.border": "#0D3B0D",
      "border": "#0D3B0D",
      "border.variant": "#0D3B0D",
      "border.focused": "#33FF33",
      "border.selected": "#33FF33",
      "panel.focused_border": "#1A8F1A",
      "text": "#33FF33",
      "text.muted": "#33FF33",
      "text.placeholder": "#1B871B",
      "text.disabled": "#146014",
      "text.accent": "#33FF33",
      "icon": "#33FF33",
      "icon.muted": "#33FF33",
      "icon.disabled": "#146014",
      "icon.accent": "#33FF33",
      // Status and version-control colours. Zed defaults these to amber/red,
      // which leaked gold into the tree's git markers. Monochrome separates
      // them by luminance instead, the way the mc skin does with file types.
      "created": "#66FF66",
      "modified": "#C8FFC8",
      "deleted": "#B1FFB1",
      "conflict": "#B1FFB1",
      "renamed": "#33FF33",
      "ignored": "#146014",
      "hidden": "#146014",
      "error": "#B1FFB1",
      "warning": "#66FF66",
      "info": "#33FF33",
      "success": "#66FF66",
      "hint": "#1B871B",
      "version_control.added": "#66FF66",
      "version_control.modified": "#C8FFC8",
      "version_control.deleted": "#B1FFB1",
      "version_control.conflict": "#B1FFB1",
      "version_control.ignored": "#146014",
      // Zed's built-in terminal is a terminal, not a code buffer, so it is
      // MDA green like foot and alacritty rather than CGA. Values are exactly
      // what Omarchy generates into the theme's foot.ini from colors.toml.
      "terminal.background": "#000000",
      "terminal.foreground": "#33FF33",
      "terminal.bright_foreground": "#C8FFC8",
      "terminal.dim_foreground": "#1B871B",
      "terminal.ansi.black": "#000000",
      "terminal.ansi.red": "#B1FFB1",
      "terminal.ansi.green": "#33FF33",
      "terminal.ansi.yellow": "#2DE22D",
      "terminal.ansi.blue": "#1E941E",
      "terminal.ansi.magenta": "#23AD23",
      "terminal.ansi.cyan": "#28C828",
      "terminal.ansi.white": "#33FF33",
      "terminal.ansi.bright_black": "#1B871B",
      "terminal.ansi.bright_red": "#E4FFE4",
      "terminal.ansi.bright_green": "#84FF84",
      "terminal.ansi.bright_yellow": "#30F030",
      "terminal.ansi.bright_blue": "#20A120",
      "terminal.ansi.bright_magenta": "#25BA25",
      "terminal.ansi.bright_cyan": "#2BD52B",
      "terminal.ansi.bright_white": "#C8FFC8",
      "terminal.ansi.dim_black": "#000000",
      "terminal.ansi.dim_red": "#31F331",
      "terminal.ansi.dim_green": "#2DE22D",
      "terminal.ansi.dim_yellow": "#28C628",
      "terminal.ansi.dim_blue": "#187A18",
      "terminal.ansi.dim_magenta": "#1D921D",
      "terminal.ansi.dim_cyan": "#23AD23",
      "terminal.ansi.dim_white": "#2DE22D",
      // Neutral buffer text is a light green rather than CGA's light grey --
      // the one role that steps outside the 16, because grey read as white
      // against everything else on the machine.
      // The CGA exception. Same role-to-color mapping as
      // extras/neovim/colors/cga1982.lua and the shipped helix.toml, so all
      // three editors read alike.
      "syntax": {
        "comment": { "color": "#555555", "font_style": "italic" },
        "comment.doc": { "color": "#555555", "font_style": "italic" },
        "keyword": { "color": "#FF55FF" },
        "operator": { "color": "#8FE88F" },
        "punctuation": { "color": "#8FE88F" },
        "punctuation.bracket": { "color": "#8FE88F" },
        "punctuation.delimiter": { "color": "#8FE88F" },
        "punctuation.list_marker": { "color": "#8FE88F" },
        "punctuation.special": { "color": "#FF55FF" },
        "string": { "color": "#55FF55" },
        "string.escape": { "color": "#FF55FF" },
        "string.regex": { "color": "#FF55FF" },
        "string.special": { "color": "#55FFFF" },
        "string.special.symbol": { "color": "#55FFFF" },
        "text.literal": { "color": "#55FF55" },
        "number": { "color": "#FF5555" },
        "boolean": { "color": "#FF5555" },
        "constant": { "color": "#FF5555" },
        "variable": { "color": "#8FE88F" },
        "variable.special": { "color": "#FF5555" },
        "property": { "color": "#8FE88F" },
        "field": { "color": "#8FE88F" },
        "function": { "color": "#55FFFF" },
        "function.method": { "color": "#55FFFF" },
        "function.definition": { "color": "#55FFFF" },
        "constructor": { "color": "#FFFF55" },
        "type": { "color": "#FFFF55" },
        "type.builtin": { "color": "#FFFF55" },
        "enum": { "color": "#FFFF55" },
        "variant": { "color": "#FFFF55" },
        "attribute": { "color": "#FFFF55" },
        "label": { "color": "#55FFFF" },
        "tag": { "color": "#FF55FF" },
        "preproc": { "color": "#AA5500" },
        "embedded": { "color": "#8FE88F" },
        "primary": { "color": "#8FE88F" },
        "title": { "color": "#FFFF55", "font_weight": 700 },
        "emphasis": { "color": "#8FE88F", "font_style": "italic" },
        "emphasis.strong": { "color": "#FFFFFF", "font_weight": 700 },
        "link_text": { "color": "#55FF55" },
        "link_uri": { "color": "#55FFFF" },
        "hint": { "color": "#555555", "font_style": "italic" },
        "predictive": { "color": "#555555", "font_style": "italic" }
      }
    }
  },
}
