// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "theme_overrides": {
    "One Dark": {
      "background": "#000000",
      "surface.background": "#000000",
      "elevated_surface.background": "#000000",
      "editor.background": "#000000",
      "editor.gutter.background": "#000000",
      "editor.subheader.background": "#0A0A0A",
      "editor.active_line.background": "#0A0A0A",
      "editor.highlighted_line.background": "#141414",
      "editor.foreground": "#AAAAAA",
      "editor.line_number": "#555555",
      "editor.active_line_number": "#FFFF55",
      "panel.background": "#000000",
      "panel.indent_guide": "#0D3B0D",
      "panel.indent_guide_hover": "#33FF33",
      "panel.indent_guide_active": "#33FF33",
      "panel.overlay_background": "#0A1A0A",
      "panel.overlay_hover": "#145014",
      "tab_bar.background": "#000000",
      "tab.inactive_background": "#0D2A0D",
      "tab.active_background": "#164016",
      "title_bar.background": "#000000",
      "title_bar.inactive_background": "#000000",
      "toolbar.background": "#000000",
      "status_bar.background": "#000000",
      "element.background": "#0A1A0A",
      "element.hover": "#145014",
      "element.active": "#1C7A1C",
      "element.selected": "#1A8F1A",
      "element.selection_background": "#1A8F1A",
      "element.disabled": "#0A1A0A",
      "ghost_element.hover": "#145014",
      "ghost_element.active": "#1C7A1C",
      "ghost_element.selected": "#1A8F1A",
      "ghost_element.disabled": "#0A1A0A",
      "drop_target.background": "#33FF3366",
      "drop_target.border": "#33FF33",
      "scrollbar.thumb.background": "#0D3B0D80",
      "scrollbar.thumb.hover_background": "#33FF3380",
      "scrollbar.thumb.active_background": "#33FF33AA",
      "scrollbar.thumb.border": "#0D3B0D",
      "border": "#0D3B0D",
      "border.variant": "#0D3B0D",
      "border.focused": "#33FF33",
      "border.selected": "#33FF33",
      "panel.focused_border": "#1A8F1A",
      "text": "#33FF33",
      "text.muted": "#1C7A1C",
      "text.placeholder": "#146014",
      "text.disabled": "#146014",
      "text.accent": "#33FF33",
      "icon": "#33FF33",
      "icon.muted": "#1C7A1C",
      "icon.disabled": "#146014",
      "icon.accent": "#33FF33",
      // The CGA exception. Same role-to-color mapping as
      // extras/neovim/colors/cga1982.lua, so both editors read alike.
      "syntax": {
        "comment": { "color": "#555555", "font_style": "italic" },
        "comment.doc": { "color": "#555555", "font_style": "italic" },
        "keyword": { "color": "#FF55FF" },
        "operator": { "color": "#AAAAAA" },
        "punctuation": { "color": "#AAAAAA" },
        "punctuation.bracket": { "color": "#AAAAAA" },
        "punctuation.delimiter": { "color": "#AAAAAA" },
        "punctuation.list_marker": { "color": "#AAAAAA" },
        "punctuation.special": { "color": "#FF55FF" },
        "string": { "color": "#55FF55" },
        "string.escape": { "color": "#FF55FF" },
        "string.regex": { "color": "#FF55FF" },
        "string.special": { "color": "#55FFFF" },
        "string.special.symbol": { "color": "#55FFFF" },
        "text.literal": { "color": "#55FF55" },
        "number": { "color": "#FF5555" },
        "boolean": { "color": "#FF5555" },
        "constant": { "color": "#FF5555" },
        "variable": { "color": "#AAAAAA" },
        "variable.special": { "color": "#FF5555" },
        "property": { "color": "#AAAAAA" },
        "field": { "color": "#AAAAAA" },
        "function": { "color": "#55FFFF" },
        "function.method": { "color": "#55FFFF" },
        "function.definition": { "color": "#55FFFF" },
        "constructor": { "color": "#FFFF55" },
        "type": { "color": "#FFFF55" },
        "type.builtin": { "color": "#FFFF55" },
        "enum": { "color": "#FFFF55" },
        "variant": { "color": "#FFFF55" },
        "attribute": { "color": "#FFFF55" },
        "label": { "color": "#55FFFF" },
        "tag": { "color": "#FF55FF" },
        "preproc": { "color": "#AA5500" },
        "embedded": { "color": "#AAAAAA" },
        "primary": { "color": "#AAAAAA" },
        "title": { "color": "#FFFF55", "font_weight": 700 },
        "emphasis": { "color": "#AAAAAA", "font_style": "italic" },
        "emphasis.strong": { "color": "#FFFFFF", "font_weight": 700 },
        "link_text": { "color": "#55FF55" },
        "link_uri": { "color": "#55FFFF" },
        "hint": { "color": "#555555", "font_style": "italic" },
        "predictive": { "color": "#555555", "font_style": "italic" }
      }
    }
  },
}
