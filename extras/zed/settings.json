// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  // One font, one size, everywhere -- matches foot, the Omarchy bar and GTK.
  // Terminess is Terminus patched with Nerd Font glyphs; its 16px bitmap is an
  // 8x16 cell, so 16px renders it pixel-perfect rather than interpolated.
  "ui_font_family": "Terminess Nerd Font Mono",
  "ui_font_size": 16,
  "buffer_font_family": "Terminess Nerd Font Mono",
  "buffer_font_size": 16,
  "terminal": {
    "font_family": "Terminess Nerd Font Mono",
    "font_size": 16
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "theme_overrides": {
    "One Dark": {
      "background": "#000000",
      "surface.background": "#000000",
      "elevated_surface.background": "#000000",
      "editor.background": "#000000",
      "editor.gutter.background": "#000000",
      "editor.subheader.background": "#0A1A0A",
      "editor.active_line.background": "#0A1A0A",
      "editor.highlighted_line.background": "#0D3B0D",
      "editor.foreground": "#33FF33",
      "editor.line_number": "#1B871B",
      "editor.active_line_number": "#33FF33",
      "panel.background": "#000000",
      "panel.indent_guide": "#0D3B0D",
      "panel.indent_guide_hover": "#33FF33",
      "panel.indent_guide_active": "#33FF33",
      "panel.overlay_background": "#0A1A0A",
      "panel.overlay_hover": "#0D3B0D",
      "tab_bar.background": "#000000",
      "tab.inactive_background": "#0A1A0A",
      "tab.active_background": "#0D3B0D",
      "title_bar.background": "#000000",
      "title_bar.inactive_background": "#000000",
      "toolbar.background": "#000000",
      "status_bar.background": "#000000",
      "element.background": "#0A1A0A",
      "element.hover": "#0D3B0D",
      "element.active": "#0D3B0D",
      "element.selected": "#0D3B0D",
      "element.selection_background": "#0D3B0D",
      "element.disabled": "#0A1A0A",
      "ghost_element.hover": "#0D3B0D",
      "ghost_element.active": "#1B871B",
      "ghost_element.selected": "#1A8F1A",
      "ghost_element.disabled": "#0A1A0A",
      "drop_target.background": "#33FF3366",
      "drop_target.border": "#33FF33",
      "scrollbar.thumb.background": "#0D3B0D80",
      "scrollbar.thumb.hover_background": "#33FF3380",
      "scrollbar.thumb.active_background": "#33FF33AA",
      "scrollbar.thumb.border": "#0D3B0D",
      "border": "#0D3B0D",
      "border.variant": "#0D3B0D",
      "border.focused": "#33FF33",
      "border.selected": "#33FF33",
      "panel.focused_border": "#1A8F1A",
      "text": "#33FF33",
      "text.muted": "#33FF33",
      "text.placeholder": "#1B871B",
      "text.disabled": "#146014",
      "text.accent": "#33FF33",
      "icon": "#33FF33",
      "icon.muted": "#33FF33",
      "icon.disabled": "#146014",
      "icon.accent": "#33FF33",
      // Status and version-control colours. Zed defaults these to amber/red,
      // which leaked gold into the tree's git markers. Monochrome separates
      // them by luminance instead, the way the mc skin does with file types.
      "created": "#66FF66",
      "modified": "#C8FFC8",
      "deleted": "#B1FFB1",
      "conflict": "#B1FFB1",
      "renamed": "#33FF33",
      "ignored": "#146014",
      "hidden": "#146014",
      "error": "#B1FFB1",
      "warning": "#66FF66",
      "info": "#33FF33",
      "success": "#66FF66",
      "hint": "#1B871B",
      "version_control.added": "#66FF66",
      "version_control.modified": "#C8FFC8",
      "version_control.deleted": "#B1FFB1",
      "version_control.conflict": "#B1FFB1",
      "version_control.ignored": "#146014",
      // Zed's built-in terminal is a terminal, not a code buffer, so it is
      // MDA green like foot and alacritty rather than CGA. Values are exactly
      // what Omarchy generates into the theme's foot.ini from colors.toml.
      "terminal.background": "#000000",
      "terminal.foreground": "#33FF33",
      "terminal.bright_foreground": "#C8FFC8",
      "terminal.dim_foreground": "#1B871B",
      "terminal.ansi.black": "#000000",
      "terminal.ansi.red": "#B1FFB1",
      "terminal.ansi.green": "#33FF33",
      "terminal.ansi.yellow": "#2DE22D",
      "terminal.ansi.blue": "#1E941E",
      "terminal.ansi.magenta": "#23AD23",
      "terminal.ansi.cyan": "#28C828",
      "terminal.ansi.white": "#33FF33",
      "terminal.ansi.bright_black": "#1B871B",
      "terminal.ansi.bright_red": "#E4FFE4",
      "terminal.ansi.bright_green": "#84FF84",
      "terminal.ansi.bright_yellow": "#30F030",
      "terminal.ansi.bright_blue": "#20A120",
      "terminal.ansi.bright_magenta": "#25BA25",
      "terminal.ansi.bright_cyan": "#2BD52B",
      "terminal.ansi.bright_white": "#C8FFC8",
      "terminal.ansi.dim_black": "#000000",
      "terminal.ansi.dim_red": "#84FF84",
      "terminal.ansi.dim_green": "#30F030",
      "terminal.ansi.dim_yellow": "#2BD52B",
      "terminal.ansi.dim_blue": "#1B871B",
      "terminal.ansi.dim_magenta": "#20A120",
      "terminal.ansi.dim_cyan": "#25BA25",
      "terminal.ansi.dim_white": "#30F030",
      // The buffer is MDA too. No hue anywhere on the machine: syntax roles
      // sit on the same L* ladder as colors.toml, spaced at least 4 L* apart
      // so adjacent roles stay apart on a phosphor tube. Brightness carries
      // the information colour would have.
      "syntax": {
        // L* 49.1 -- recedes
        "comment": { "color": "#1B871B", "font_style": "italic" },
        "comment.doc": { "color": "#1B871B", "font_style": "italic" },
        "hint": { "color": "#1B871B", "font_style": "italic" },
        "predictive": { "color": "#1B871B", "font_style": "italic" },
        // L* 57.9 -- structure sits below the text it separates
        "operator": { "color": "#20A120" },
        "punctuation": { "color": "#20A120" },
        "punctuation.bracket": { "color": "#20A120" },
        "punctuation.delimiter": { "color": "#20A120" },
        "punctuation.list_marker": { "color": "#20A120" },
        // L* 66.2
        "preproc": { "color": "#25BA25" },
        // L* 70.8
        "function": { "color": "#28C828" },
        "function.method": { "color": "#28C828" },
        "function.definition": { "color": "#28C828" },
        "constructor": { "color": "#28C828" },
        "label": { "color": "#28C828" },
        // L* 75.0
        "number": { "color": "#2BD52B" },
        "boolean": { "color": "#2BD52B" },
        "constant": { "color": "#2BD52B" },
        "variable.special": { "color": "#2BD52B" },
        // L* 79.1
        "string": { "color": "#2DE22D" },
        "string.special": { "color": "#2DE22D" },
        "string.special.symbol": { "color": "#2DE22D" },
        "text.literal": { "color": "#2DE22D" },
        "link_text": { "color": "#2DE22D" },
        // L* 83.5
        "type": { "color": "#30F030" },
        "type.builtin": { "color": "#30F030" },
        "enum": { "color": "#30F030" },
        "variant": { "color": "#30F030" },
        "attribute": { "color": "#30F030" },
        "link_uri": { "color": "#30F030" },
        // L* 88.2 -- body text, the green the tube is named for
        "variable": { "color": "#33FF33" },
        "field": { "color": "#33FF33" },
        "embedded": { "color": "#33FF33" },
        "primary": { "color": "#33FF33" },
        "emphasis": { "color": "#33FF33", "font_style": "italic" },
        // L* 93.5 -- the loudest rung: keywords, and the tags that frame a document
        "keyword": { "color": "#B1FFB1" },
        "tag": { "color": "#B1FFB1" },
        // A declaration's key, a rung above its value: in CSS the property
        // name, elsewhere an object key or a struct field. Zed's syntax map is
        // not per-language, so this is also `foo.bar` member access in JS.
        "property": { "color": "#B1FFB1" },
        "punctuation.special": { "color": "#B1FFB1" },
        "string.escape": { "color": "#B1FFB1" },
        "string.regex": { "color": "#B1FFB1" },
        // L* 97.5 -- bloom
        "title": { "color": "#E4FFE4", "font_weight": 700 },
        "emphasis.strong": { "color": "#E4FFE4", "font_weight": 700 }
      }
    }
  },
}
